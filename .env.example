# ═══════════════════════════════════════════════════
#  JournalismLab — Environment Variables
#  Copy these into Dokploy → App → Environment
#  DO NOT commit the real .env to git
# ═══════════════════════════════════════════════════

# Firebase Web Config (Option 1: Exact lowercase variable names)
apiKey=your_api_key_here
authDomain=your-project.firebaseapp.com
databaseURL=https://your-project-default-rtdb.firebaseio.com
projectId=your-project-id
storageBucket=your-project.appspot.com
messagingSenderId=000000000000
appId=1:000000000000:web:abc123

# Firebase Web Config (Option 2: Uppercase prefixed variable names)
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abc123

# Admin panel credentials & Google Auth whitelist
ADMIN_EMAIL=admin@journalismlab.in
ADMIN_PASSWORD=JLab@2026!
ADMIN_EMAILS=admin@journalismlab.in,soumalya9862@gmail.com,minalpareek18@gmail.com,thearcart@gmail.com

# Captcha Security API Key / Site Key
CAPTCHA_API_KEY=your_captcha_api_key_here
CAPTCHA_SITE_KEY=your_captcha_site_key_here
