# ═══════════════════════════════════════════════════
#  JournalismLab — Environment Variables
#  Copy these into Dokploy → App → Environment
#  DO NOT commit the real .env to git
# ═══════════════════════════════════════════════════

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abc123

# Admin panel credentials
ADMIN_EMAIL=admin@journalismlab.in
ADMIN_PASSWORD=JLab@2026!
